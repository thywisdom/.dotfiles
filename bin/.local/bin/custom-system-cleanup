#!/usr/bin/env bash
# ==============================================================================
# system-cleanup - Production-Quality Arch Linux Maintenance & Cleanup Utility
# ==============================================================================
# Designed specifically for:
#   - Arch Linux
#   - systemd
#   - pacman
#   - Snapper & Btrfs systems
#   - Normal desktop users
#
# Features:
#   - Single sudo authentication at startup with background keep-alive
#   - Exact before/after du disk usage measurements and space accounting
#   - Dry-run inspection mode
#   - Native pacman -Scc with residual download-* directory fallback
#   - Safe systemd-coredump cleanup (preserves metadata integrity)
#   - User cache (~/.cache) and Trash cleanup with explicit confirmations
#   - Safe /tmp and /var/tmp cleanup using systemd-tmpfiles & runtime socket protection
#   - Traditional /var/log rotated archive cleanup (excludes /var/log/journal & pacman.log)
#   - systemd journal vacuuming (conservative & aggressive options)
#   - Snapper snapshot management with strict protection for snapshot 0
#   - Full cleanup batch/interactive execution flow
#   - Comprehensive failure tracking and summary reporting
#   - Optional BleachBit integration upon exit
# ==============================================================================

set -u
set -o pipefail

# Set Wayland app ID for Hyprland floating window rule
export WAYLAND_APP_ID="custom-script"

# ------------------------------------------------------------------------------
# 1. Global Constants & Configuration
# ------------------------------------------------------------------------------
readonly SCRIPT_NAME="system-cleanup"
readonly SCRIPT_VERSION="1.0.0"
readonly PACMAN_PKG_CACHE="/var/cache/pacman/pkg"
readonly COREDUMP_DIR="/var/lib/systemd/coredump"
readonly USER_CACHE_DIR="${HOME}/.cache"
readonly USER_TRASH_DIR="${HOME}/.local/share/Trash"
readonly TMP_DIR="/tmp"
readonly VAR_TMP_DIR="/var/tmp"
readonly VAR_LOG_DIR="/var/log"
readonly JOURNAL_LOG_DIR="/var/log/journal"

# Background keep-alive process ID for sudo
SUDO_KEEPALIVE_PID=""

# Running totals and statistics
declare -a STAGE_KEYS=()
declare -A STAGE_LABELS=()
declare -A STAGE_BEFORE=()
declare -A STAGE_AFTER=()
declare -A STAGE_RECLAIMED=()
declare -A STAGE_STATUS=()
declare -A STAGE_NOTES=()

# Batch mode flag ("all" = pre-approve standard prompts, "step" = ask each stage)
BATCH_CONFIRM_ALL=0

# ------------------------------------------------------------------------------
# 2. Terminal UI & Styling
# ------------------------------------------------------------------------------
# Detect color support
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-}" != "dumb" ]]; then
    readonly C_RESET="\033[0m"
    readonly C_BOLD="\033[1m"
    readonly C_DIM="\033[2m"
    readonly C_RED="\033[1;31m"
    readonly C_GREEN="\033[1;32m"
    readonly C_YELLOW="\033[1;33m"
    readonly C_BLUE="\033[1;34m"
    readonly C_MAGENTA="\033[1;35m"
    readonly C_CYAN="\033[1;36m"
    readonly C_WHITE="\033[1;37m"
    readonly C_GRAY="\033[0;90m"
else
    readonly C_RESET=""
    readonly C_BOLD=""
    readonly C_DIM=""
    readonly C_RED=""
    readonly C_GREEN=""
    readonly C_YELLOW=""
    readonly C_BLUE=""
    readonly C_MAGENTA=""
    readonly C_CYAN=""
    readonly C_WHITE=""
    readonly C_GRAY=""
fi

# Status Tags
print_info()  { echo -e "${C_BLUE}[INFO]${C_RESET}  $*"; }
print_check() { echo -e "${C_CYAN}[CHECK]${C_RESET} $*"; }
print_clean() { echo -e "${C_MAGENTA}[CLEAN]${C_RESET} $*"; }
print_done()  { echo -e "${C_GREEN}[DONE]${C_RESET}  $*"; }
print_skip()  { echo -e "${C_GRAY}[SKIP]${C_RESET}  $*"; }
print_warn()  { echo -e "${C_YELLOW}[WARN]${C_RESET}  $*"; }
print_error() { echo -e "${C_RED}[ERROR]${C_RESET} $*"; }

# UI Box & Separator Helpers
print_header() {
    local title="$1"
    local width=68
    local line
    printf -v line '%*s' "$width" ''
    line="${line// /─}"
    echo ""
    echo -e "${C_CYAN}┌${line}┐${C_RESET}"
    printf "${C_CYAN}│${C_BOLD}${C_WHITE} %-*s ${C_CYAN}│${C_RESET}\n" $((width - 2)) "$title"
    echo -e "${C_CYAN}└${line}┘${C_RESET}"
}

print_section() {
    local title="$1"
    echo ""
    echo -e "${C_BOLD}${C_WHITE}── ${title} ${C_GRAY}──────────────────────────────────────────────${C_RESET}"
}

print_divider() {
    echo -e "${C_GRAY}────────────────────────────────────────────────────────────────────${C_RESET}"
}

# ------------------------------------------------------------------------------
# 3. Process & Signal Cleanup Traps
# ------------------------------------------------------------------------------
cleanup_on_exit() {
    local exit_code=$?
    # Restore cursor if hidden
    tput cnorm 2>/dev/null || true
    # Terminate background sudo keepalive
    if [[ -n "${SUDO_KEEPALIVE_PID}" ]] && kill -0 "${SUDO_KEEPALIVE_PID}" 2>/dev/null; then
        kill "${SUDO_KEEPALIVE_PID}" 2>/dev/null || true
        wait "${SUDO_KEEPALIVE_PID}" 2>/dev/null || true
    fi
    exit "$exit_code"
}

trap cleanup_on_exit EXIT INT TERM HUP

# ------------------------------------------------------------------------------
# 4. Sudo Lifecycle & Authentication
# ------------------------------------------------------------------------------
init_sudo_auth() {
    print_section "Sudo Authentication"

    # Verify not running directly as root
    if [[ "${EUID}" -eq 0 ]]; then
        print_error "Do not run ${SCRIPT_NAME} directly as root."
        echo "       Please run as a regular user with sudo privileges."
        echo "       The script will elevate specific operations safely."
        exit 1
    fi

    # Check for sudo binary
    if ! command -v sudo >/dev/null 2>&1; then
        print_error "The 'sudo' command is required but not found in PATH."
        exit 1
    fi

    print_info "Current user: ${C_BOLD}${USER}${C_RESET} (UID: $(id -u))"
    print_info "Authenticating with sudo for system maintenance tasks..."

    local auth_success=0
    while [[ $auth_success -eq 0 ]]; do
        if sudo -v -p "[sudo] Password for %u: "; then
            auth_success=1
            print_done "Sudo authentication validated."
        else
            print_error "Sudo authentication failed."
            echo ""
            echo "Options:"
            echo "  1) Retry password"
            echo "  2) Exit script"
            read -rp "Select [1-2] (default 1): " retry_choice
            retry_choice="${retry_choice:-1}"
            if [[ "$retry_choice" != "1" ]]; then
                echo "Exiting."
                exit 1
            fi
        fi
    done

    # Spawn background keep-alive loop (pings sudo every 50s while parent $$ lives)
    (
        while kill -0 "$$" 2>/dev/null; do
            sleep 50
            sudo -n -v 2>/dev/null || break
        done
    ) &
    SUDO_KEEPALIVE_PID=$!
}

# ------------------------------------------------------------------------------
# 5. Helpers: Formatting, Accounting, Spinners & Prompts
# ------------------------------------------------------------------------------
format_bytes() {
    local bytes="${1:-0}"
    # Ensure numeric
    if [[ ! "$bytes" =~ ^[0-9]+$ ]]; then
        echo "0 B"
        return
    fi

    if (( bytes < 1024 )); then
        echo "${bytes} B"
    elif (( bytes < 1048576 )); then
        awk -v b="$bytes" 'BEGIN { printf "%.2f KiB", b/1024 }'
    elif (( bytes < 1073741824 )); then
        awk -v b="$bytes" 'BEGIN { printf "%.2f MiB", b/1048576 }'
    elif (( bytes < 1099511627776 )); then
        awk -v b="$bytes" 'BEGIN { printf "%.2f GiB", b/1073741824 }'
    else
        awk -v b="$bytes" 'BEGIN { printf "%.2f TiB", b/1099511627776 }'
    fi
}

get_path_size_bytes() {
    local target_path="$1"
    local use_sudo="${2:-0}"

    if [[ ! -e "$target_path" ]]; then
        echo 0
        return
    fi

    local size_bytes=""
    if [[ "$use_sudo" -eq 1 ]]; then
        size_bytes=$(sudo du -s --block-size=1 "$target_path" 2>/dev/null | awk '{print $1}')
    else
        size_bytes=$(du -s --block-size=1 "$target_path" 2>/dev/null | awk '{print $1}')
    fi

    echo "${size_bytes:-0}"
}

get_journal_size_bytes() {
    if [[ -d "$JOURNAL_LOG_DIR" ]]; then
        get_path_size_bytes "$JOURNAL_LOG_DIR" 1
    elif [[ -d "/run/log/journal" ]]; then
        get_path_size_bytes "/run/log/journal" 1
    else
        echo 0
    fi
}

run_with_spinner() {
    local message="$1"
    shift
    local log_file
    log_file=$(mktemp /tmp/system-cleanup-cmd.XXXXXX)

    local spin_chars=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local spin_idx=0

    # Hide cursor
    tput civis 2>/dev/null || true

    # Execute command in background
    "$@" >"$log_file" 2>&1 &
    local cmd_pid=$!

    while kill -0 "$cmd_pid" 2>/dev/null; do
        printf "\r${C_CYAN}%s${C_RESET} %s..." "${spin_chars[spin_idx]}" "$message"
        spin_idx=$(( (spin_idx + 1) % ${#spin_chars[@]} ))
        sleep 0.08
    done

    wait "$cmd_pid"
    local exit_status=$?

    # Clear spinner line
    printf "\r\033[K"
    tput cnorm 2>/dev/null || true

    if [[ $exit_status -eq 0 ]]; then
        print_done "$message completed."
    else
        print_error "$message failed (exit code $exit_status)."
        if [[ -s "$log_file" ]]; then
            echo -e "${C_GRAY}--- Command Output ---${C_RESET}"
            head -n 20 "$log_file" | sed 's/^/  /'
            if (( $(wc -l < "$log_file") > 20 )); then
                echo "  ... (output truncated)"
            fi
            echo -e "${C_GRAY}----------------------${C_RESET}"
        fi
    fi

    rm -f "$log_file"
    return "$exit_status"
}

prompt_confirm() {
    local question="$1"
    local default_ans="${2:-N}" # Y or N

    # If running in batch "Confirm all" mode, accept standard non-critical confirmations
    if [[ "$BATCH_CONFIRM_ALL" -eq 1 ]]; then
        echo -e "${question} ${C_DIM}[Batch confirmed: Yes]${C_RESET}"
        return 0
    fi

    local prompt_str="[y/N]"
    [[ "${default_ans^^}" == "Y" ]] && prompt_str="[Y/n]"

    echo -ne "${C_YELLOW}${question} ${prompt_str}:${C_RESET} "
    local reply
    read -r reply
    reply="${reply:-$default_ans}"

    if [[ "${reply^^}" == "Y" || "${reply^^}" == "YES" ]]; then
        return 0
    else
        return 1
    fi
}

record_stage_result() {
    local stage_key="$1"
    local label="$2"
    local before_b="$3"
    local after_b="$4"
    local status="$5" # SUCCESS, PARTIAL, SKIPPED, FAILED
    local notes="${6:-}"

    local reclaimed_b=0
    if (( before_b > after_b )); then
        reclaimed_b=$(( before_b - after_b ))
    fi

    STAGE_KEYS+=("$stage_key")
    STAGE_LABELS["$stage_key"]="$label"
    STAGE_BEFORE["$stage_key"]="$before_b"
    STAGE_AFTER["$stage_key"]="$after_b"
    STAGE_RECLAIMED["$stage_key"]="$reclaimed_b"
    STAGE_STATUS["$stage_key"]="$status"
    STAGE_NOTES["$stage_key"]="$notes"
}

# ------------------------------------------------------------------------------
# 6. Overview & Dry-Run Inspection
# ------------------------------------------------------------------------------
get_snapper_info() {
    local -n out_installed=$1
    local -n out_configs=$2
    local -n out_total_snaps=$3
    local -n out_removable_snaps=$4

    out_installed=0
    out_configs=""
    out_total_snaps=0
    out_removable_snaps=0

    if ! command -v snapper >/dev/null 2>&1; then
        return
    fi
    out_installed=1

    local cfg_list
    cfg_list=$(snapper list-configs 2>/dev/null | awk 'NR>2 {print $1}')
    out_configs="$cfg_list"

    if [[ -z "$cfg_list" ]]; then
        return
    fi

    for cfg in $cfg_list; do
        local snap_lines
        snap_lines=$(sudo snapper -c "$cfg" list 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9]+$/')
        if [[ -n "$snap_lines" ]]; then
            local count
            count=$(echo "$snap_lines" | wc -l)
            out_total_snaps=$(( out_total_snaps + count ))
            # Exclude snapshot 0
            local removable
            removable=$(echo "$snap_lines" | awk '$1 != "0"' | wc -l)
            out_removable_snaps=$(( out_removable_snaps + removable ))
        fi
    done
}

show_system_overview() {
    print_header "Arch Linux System Overview"

    local hostname_str
    hostname_str=$(uname -n 2>/dev/null || echo "unknown")

    # Filesystem info
    local root_df home_df
    root_df=$(df -h / 2>/dev/null | awk 'NR==2 {printf "%s used / %s total (%s avail, %s)", $3, $2, $4, $5}')
    home_df=$(df -h "$HOME" 2>/dev/null | awk 'NR==2 {printf "%s used / %s total (%s avail, %s)", $3, $2, $4, $5}')

    # Target measurements
    local sz_journal sz_pacman sz_coredump sz_trash sz_tmp sz_vartmp
    sz_journal=$(get_journal_size_bytes)
    sz_pacman=$(get_path_size_bytes "$PACMAN_PKG_CACHE" 1)
    sz_coredump=$(get_path_size_bytes "$COREDUMP_DIR" 1)
    sz_trash=$(get_path_size_bytes "$USER_TRASH_DIR" 0)
    sz_tmp=$(get_path_size_bytes "$TMP_DIR" 1)
    sz_vartmp=$(get_path_size_bytes "$VAR_TMP_DIR" 1)

    # Snapper inspection
    local snap_installed snap_configs snap_total snap_removable
    get_snapper_info snap_installed snap_configs snap_total snap_removable

    echo -e "${C_BOLD}System Properties:${C_RESET}"
    printf "  • %-24s : %s\n" "Hostname" "$hostname_str"
    printf "  • %-24s : %s\n" "User" "$USER"
    printf "  • %-24s : %s\n" "Root (/) Usage" "$root_df"
    printf "  • %-24s : %s\n" "Home (~/) Usage" "$home_df"

    echo ""
    echo -e "${C_BOLD}Cleanup Targets Storage:${C_RESET}"
    printf "  • %-24s : %-12s ${C_GRAY}(/var/cache/pacman/pkg)${C_RESET}\n" "Pacman Cache" "$(format_bytes "$sz_pacman")"
    printf "  • %-24s : %-12s ${C_GRAY}(systemd journal)${C_RESET}\n" "systemd Journal" "$(format_bytes "$sz_journal")"
    printf "  • %-24s : %-12s ${C_GRAY}(/var/lib/systemd/coredump)${C_RESET}\n" "Coredumps" "$(format_bytes "$sz_coredump")"
    printf "  • %-24s : %-12s ${C_GRAY}(~/.local/share/Trash)${C_RESET}\n" "User Trash" "$(format_bytes "$sz_trash")"
    printf "  • %-24s : %-12s ${C_GRAY}(/tmp)${C_RESET}\n" "Temporary Files" "$(format_bytes "$sz_tmp")"
    printf "  • %-24s : %-12s ${C_GRAY}(/var/tmp)${C_RESET}\n" "Persistent Temp" "$(format_bytes "$sz_vartmp")"

    if [[ "$snap_installed" -eq 1 ]]; then
        printf "  • %-24s : %d total (%d removable, snapshot 0 protected)\n" "Snapper Snapshots" "$snap_total" "$snap_removable"
    else
        printf "  • %-24s : Snapper not installed / no config\n" "Snapper Snapshots"
    fi
    print_divider
}

do_review_overview() {
    print_header "Option 1: Review Cleanup Targets (Dry-Run Mode)"
    print_info "Scanning all maintenance targets. No files will be modified or removed."

    local sz_coredump sz_pacman sz_ucache sz_trash sz_tmp sz_vartmp sz_tradlog sz_journal
    sz_coredump=$(get_path_size_bytes "$COREDUMP_DIR" 1)
    sz_pacman=$(get_path_size_bytes "$PACMAN_PKG_CACHE" 1)
    sz_ucache=$(get_path_size_bytes "$USER_CACHE_DIR" 0)
    sz_trash=$(get_path_size_bytes "$USER_TRASH_DIR" 0)
    sz_tmp=$(get_path_size_bytes "$TMP_DIR" 1)
    sz_vartmp=$(get_path_size_bytes "$VAR_TMP_DIR" 1)
    sz_journal=$(get_journal_size_bytes)

    # Traditional logs (exclude /var/log/journal)
    local sz_tradlog=0
    if [[ -d "$VAR_LOG_DIR" ]]; then
        local total_log
        total_log=$(get_path_size_bytes "$VAR_LOG_DIR" 1)
        if (( total_log >= sz_journal )); then
            sz_tradlog=$(( total_log - sz_journal ))
        else
            sz_tradlog="$total_log"
        fi
    fi

    local snap_installed snap_configs snap_total snap_removable
    get_snapper_info snap_installed snap_configs snap_total snap_removable

    echo ""
    echo -e "${C_BOLD}┌─────────────────────────┬───────────────────────────────┬────────────┬────────────────────────┐${C_RESET}"
    echo -e "${C_BOLD}│ Category                │ Target Path                   │ Size       │ Safety Status          │${C_RESET}"
    echo -e "${C_BOLD}├─────────────────────────┼───────────────────────────────┼────────────┼────────────────────────┤${C_RESET}"

    printf "│ %-23s │ %-29s │ %10s │ ${C_GREEN}%-22s${C_RESET} │\n" \
        "Coredumps" "/var/lib/systemd/coredump" "$(format_bytes "$sz_coredump")" "Cleanable"

    printf "│ %-23s │ %-29s │ %10s │ ${C_YELLOW}%-22s${C_RESET} │\n" \
        "Pacman Package Cache" "/var/cache/pacman/pkg" "$(format_bytes "$sz_pacman")" "Requires Confirmation"

    printf "│ %-23s │ %-29s │ %10s │ ${C_YELLOW}%-22s${C_RESET} │\n" \
        "User Cache" "~/.cache/*" "$(format_bytes "$sz_ucache")" "Requires Confirmation"

    printf "│ %-23s │ %-29s │ %10s │ ${C_YELLOW}%-22s${C_RESET} │\n" \
        "User Trash" "~/.local/share/Trash" "$(format_bytes "$sz_trash")" "Requires Confirmation"

    printf "│ %-23s │ %-29s │ %10s │ ${C_GREEN}%-22s${C_RESET} │\n" \
        "/tmp Directory" "/tmp" "$(format_bytes "$sz_tmp")" "Safe Filtered Cleanup"

    printf "│ %-23s │ %-29s │ %10s │ ${C_GREEN}%-22s${C_RESET} │\n" \
        "/var/tmp Directory" "/var/tmp" "$(format_bytes "$sz_vartmp")" "Safe Filtered Cleanup"

    printf "│ %-23s │ %-29s │ %10s │ ${C_GREEN}%-22s${C_RESET} │\n" \
        "Traditional Logs" "/var/log (archived/rotated)" "$(format_bytes "$sz_tradlog")" "Safe Filtered Cleanup"

    printf "│ %-23s │ %-29s │ %10s │ ${C_YELLOW}%-22s${C_RESET} │\n" \
        "systemd Journal" "journalctl vacuum" "$(format_bytes "$sz_journal")" "Conservative/Aggressive"

    if [[ "$snap_installed" -eq 1 ]]; then
        local snap_label="${snap_removable} removable / ${snap_total} total"
        printf "│ %-23s │ %-29s │ %10s │ ${C_MAGENTA}%-22s${C_RESET} │\n" \
            "Snapper Snapshots" "Btrfs Snapshots" "$snap_label" "Snapshot 0 Protected"
    else
        printf "│ %-23s │ %-29s │ %10s │ ${C_GRAY}%-22s${C_RESET} │\n" \
            "Snapper Snapshots" "Btrfs Snapshots" "N/A" "Unavailable"
    fi

    echo -e "${C_BOLD}└─────────────────────────┴───────────────────────────────┴────────────┴────────────────────────┘${C_RESET}"

    local total_est=$(( sz_coredump + sz_pacman + sz_ucache + sz_trash + sz_tmp + sz_vartmp + sz_tradlog + sz_journal ))
    echo ""
    echo -e "${C_BOLD}Total Potentially Reclaimable Space:${C_RESET} ${C_GREEN}$(format_bytes "$total_est")${C_RESET}"
    echo -e "${C_GRAY}(Actual reclaimed space depends on active file locks, package redownload needs, and journal retention settings)${C_RESET}"
}

# ------------------------------------------------------------------------------
# 7. Category Cleaners
# ------------------------------------------------------------------------------

# Stage 2: Coredumps
do_clean_coredumps() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning Stored Coredumps"
    print_info "Target: ${C_BOLD}${COREDUMP_DIR}${C_RESET}"

    local before_bytes
    before_bytes=$(get_path_size_bytes "$COREDUMP_DIR" 1)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    if [[ ! -d "$COREDUMP_DIR" ]]; then
        print_skip "Coredump directory does not exist."
        record_stage_result "coredumps" "Coredumps" "$before_bytes" "$before_bytes" "SKIPPED" "Directory not found"
        return 0
    fi

    local dump_count
    dump_count=$(sudo find "$COREDUMP_DIR" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | wc -l)
    print_info "Found ${dump_count} stored core dump files."

    if (( dump_count == 0 )); then
        print_skip "No stored coredump files to clean."
        record_stage_result "coredumps" "Coredumps" "$before_bytes" "$before_bytes" "SKIPPED" "No stored files"
        return 0
    fi

    # Controlled deletion of regular files inside coredump dir (preserving directory & configs)
    local err_occurred=0
    if ! sudo find "$COREDUMP_DIR" -mindepth 1 -maxdepth 1 -type f -delete 2>/dev/null; then
        err_occurred=1
        print_warn "Standard deletion encountered issues, attempting fallback removal..."
        if ! sudo find "$COREDUMP_DIR" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} + 2>/dev/null; then
            err_occurred=2
        fi
    fi

    local after_bytes
    after_bytes=$(get_path_size_bytes "$COREDUMP_DIR" 1)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    print_info "Note: 'coredumpctl list' may still show 'COREFILE=missing' for past crashes."
    print_info "      This is normal because systemd journal event records are preserved."

    if (( err_occurred == 2 )); then
        print_error "Some coredump files could not be removed."
        record_stage_result "coredumps" "Coredumps" "$before_bytes" "$after_bytes" "PARTIAL" "Permission or locked file errors"
    else
        print_done "Coredump storage cleaned successfully."
        record_stage_result "coredumps" "Coredumps" "$before_bytes" "$after_bytes" "SUCCESS" ""
    fi
}

# Stage 3: Pacman Cache & Download-* Fallback
do_clean_pacman_cache() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning Pacman Package Cache"
    print_info "Target: ${C_BOLD}${PACMAN_PKG_CACHE}${C_RESET}"

    local before_bytes
    before_bytes=$(get_path_size_bytes "$PACMAN_PKG_CACHE" 1)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    if [[ ! -d "$PACMAN_PKG_CACHE" ]]; then
        print_skip "Pacman package cache directory not found."
        record_stage_result "pacman" "Pacman Cache" "$before_bytes" "$before_bytes" "SKIPPED" "Directory not found"
        return 0
    fi

    print_warn "This will run 'pacman -Scc' to remove ALL cached package tarballs and unused sync repos."
    print_warn "Packages will need to be downloaded again if reinstallation or rollback is required."

    if ! prompt_confirm "Do you want to proceed with full pacman cache cleanup?" "Y"; then
        print_skip "Pacman cache cleanup skipped by user."
        record_stage_result "pacman" "Pacman Cache" "$before_bytes" "$before_bytes" "SKIPPED" "Declined by user"
        return 0
    fi

    # Run native pacman -Scc
    local pacman_log
    pacman_log=$(mktemp /tmp/system-cleanup-pacman.XXXXXX)
    print_clean "Running native 'pacman -Scc --noconfirm'..."

    # Feed yes or --noconfirm to pacman
    if sudo pacman -Scc --noconfirm >"$pacman_log" 2>&1; then
        print_done "Native pacman cache cleaning completed."
    else
        print_warn "Pacman -Scc reported a non-zero exit or warning."
        grep -i "error" "$pacman_log" | head -n 5 || true
    fi

    # Fallback check for residual /var/cache/pacman/pkg/download-* directories
    local leftover_downloads=()
    while IFS= read -r -d $'\0' ddir; do
        leftover_downloads+=("$ddir")
    done < <(sudo find "$PACMAN_PKG_CACHE" -mindepth 1 -maxdepth 1 -type d -name "download-*" -print0 2>/dev/null)

    if (( ${#leftover_downloads[@]} > 0 )); then
        print_warn "Detected ${#leftover_downloads[@]} residual pacman 'download-*' temporary directories."
        echo "       (Common pacman issue: 'error: could not remove ...: Is a directory')"

        if prompt_confirm "Run controlled fallback to remove only residual 'download-*' directories?" "Y"; then
            print_clean "Removing residual download-* directories..."
            sudo find "$PACMAN_PKG_CACHE" -mindepth 1 -maxdepth 1 -type d -name "download-*" -exec rm -rf {} + 2>/dev/null
            print_done "Residual download directories cleaned."
        else
            print_skip "Skipped download-* fallback removal."
        fi
    fi

    rm -f "$pacman_log"

    local after_bytes
    after_bytes=$(get_path_size_bytes "$PACMAN_PKG_CACHE" 1)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    record_stage_result "pacman" "Pacman Cache" "$before_bytes" "$after_bytes" "SUCCESS" ""
}

# Stage 4: User Cache
do_clean_user_cache() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning User Cache"
    print_info "Target: ${C_BOLD}${USER_CACHE_DIR}/*${C_RESET}"

    local before_bytes
    before_bytes=$(get_path_size_bytes "$USER_CACHE_DIR" 0)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    if [[ ! -d "$USER_CACHE_DIR" ]]; then
        print_skip "User cache directory (~/.cache) does not exist."
        record_stage_result "ucache" "User Cache" "$before_bytes" "$before_bytes" "SKIPPED" "Directory not found"
        return 0
    fi

    print_info "Applications will safely regenerate required cache files upon next launch."
    print_info "Protected locations: ~/.config, ~/.local/share, and user documents are NOT touched."

    if ! prompt_confirm "Do you want to clean ~/.cache contents?" "Y"; then
        print_skip "User cache cleanup skipped by user."
        record_stage_result "ucache" "User Cache" "$before_bytes" "$before_bytes" "SKIPPED" "Declined by user"
        return 0
    fi

    print_clean "Pruning contents of ~/.cache..."
    # Controlled removal of items inside ~/.cache, keeping ~/.cache folder itself intact
    find "$USER_CACHE_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

    local after_bytes
    after_bytes=$(get_path_size_bytes "$USER_CACHE_DIR" 0)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    print_done "User cache cleaned."
    record_stage_result "ucache" "User Cache" "$before_bytes" "$after_bytes" "SUCCESS" ""
}

# Stage 5: Trash
do_clean_trash() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning User Trash"
    print_info "Target: ${C_BOLD}${USER_TRASH_DIR}${C_RESET}"

    if [[ ! -d "$USER_TRASH_DIR" ]]; then
        print_skip "Trash directory not found."
        record_stage_result "trash" "Trash" 0 0 "SKIPPED" "Trash directory not found"
        return 0
    fi

    local before_bytes
    before_bytes=$(get_path_size_bytes "$USER_TRASH_DIR" 0)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    if (( before_bytes <= 4096 )); then
        # Check if actually empty
        local item_count
        item_count=$(find "$USER_TRASH_DIR" -mindepth 1 2>/dev/null | wc -l)
        if (( item_count == 0 )); then
            print_skip "Trash is already empty."
            record_stage_result "trash" "Trash" "$before_bytes" "$before_bytes" "SKIPPED" "Already empty"
            return 0
        fi
    fi

    print_warn "Permanent deletion: files in Trash cannot be recovered."
    if ! prompt_confirm "Do you wish to permanently remove everything in Trash?" "N"; then
        print_skip "Trash cleanup skipped by user."
        record_stage_result "trash" "Trash" "$before_bytes" "$before_bytes" "SKIPPED" "Declined by user"
        return 0
    fi

    print_clean "Emptying Trash..."
    rm -rf "${USER_TRASH_DIR:?}"/* 2>/dev/null || true
    # Ensure standard trash structure exists
    mkdir -p "${USER_TRASH_DIR}/files" "${USER_TRASH_DIR}/info" 2>/dev/null || true

    local after_bytes
    after_bytes=$(get_path_size_bytes "$USER_TRASH_DIR" 0)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    print_done "Trash emptied successfully."
    record_stage_result "trash" "Trash" "$before_bytes" "$after_bytes" "SUCCESS" ""
}

# Stage 6: /tmp
do_clean_tmp() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning /tmp"
    print_info "Target: ${C_BOLD}${TMP_DIR}${C_RESET}"

    local before_bytes
    before_bytes=$(get_path_size_bytes "$TMP_DIR" 1)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    print_info "Applying safe temporary file cleanup..."
    print_info "Active runtime sockets, locks, X11, Wayland, and systemd-private dirs are strictly preserved."

    # 1. Run official systemd-tmpfiles clean
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        run_with_spinner "Running systemd-tmpfiles --clean" sudo systemd-tmpfiles --clean 2>/dev/null || true
    fi

    # 2. Controlled safe prune of stale non-locked files older than 1 day
    # Explicit exclusion of active runtime files
    local skipped_count=0
    local removed_count=0

    while IFS= read -r -d $'\0' item; do
        local bname
        bname=$(basename "$item")

        # Strict protection pattern list
        case "$bname" in
            .X11-unix|.ICE-unix|.font-unix|.XIM-unix|.Test-unix)
                skipped_count=$(( skipped_count + 1 ))
                continue
                ;;
            .X*-lock|sddm-auth-*|ssh-*|gpg-*|pipewire*|wayland-*)
                skipped_count=$(( skipped_count + 1 ))
                continue
                ;;
            systemd-private-*)
                skipped_count=$(( skipped_count + 1 ))
                continue
                ;;
        esac

        # Skip active sockets and pipes
        if [[ -S "$item" || -p "$item" ]]; then
            skipped_count=$(( skipped_count + 1 ))
            continue
        fi

        # Attempt safe removal of files modified more than 1 day ago
        if sudo rm -rf "$item" 2>/dev/null; then
            removed_count=$(( removed_count + 1 ))
        else
            skipped_count=$(( skipped_count + 1 ))
        fi
    done < <(sudo find "$TMP_DIR" -mindepth 1 -maxdepth 1 -mtime +1 -print0 2>/dev/null)

    local after_bytes
    after_bytes=$(get_path_size_bytes "$TMP_DIR" 1)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"
    print_info "Summary: Removed ${removed_count} stale items, preserved/skipped ${skipped_count} active items."

    if (( skipped_count > 0 && removed_count > 0 )); then
        record_stage_result "tmp" "/tmp" "$before_bytes" "$after_bytes" "PARTIAL" "Preserved ${skipped_count} active/locked runtime files"
    else
        record_stage_result "tmp" "/tmp" "$before_bytes" "$after_bytes" "SUCCESS" ""
    fi
}

# Stage 7: /var/tmp
do_clean_var_tmp() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning /var/tmp"
    print_info "Target: ${C_BOLD}${VAR_TMP_DIR}${C_RESET}"

    local before_bytes
    before_bytes=$(get_path_size_bytes "$VAR_TMP_DIR" 1)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    print_info "/var/tmp can intentionally persist across reboots."
    print_info "Running controlled systemd-tmpfiles and stale file maintenance..."

    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        run_with_spinner "Running systemd-tmpfiles --clean for /var/tmp" sudo systemd-tmpfiles --clean 2>/dev/null || true
    fi

    # Prune stale files older than 7 days in /var/tmp
    local skipped_count=0
    local removed_count=0

    while IFS= read -r -d $'\0' item; do
        local bname
        bname=$(basename "$item")
        if [[ "$bname" =~ ^systemd-private- ]]; then
            skipped_count=$(( skipped_count + 1 ))
            continue
        fi

        if sudo rm -rf "$item" 2>/dev/null; then
            removed_count=$(( removed_count + 1 ))
        else
            skipped_count=$(( skipped_count + 1 ))
        fi
    done < <(sudo find "$VAR_TMP_DIR" -mindepth 1 -maxdepth 1 -mtime +7 -print0 2>/dev/null)

    local after_bytes
    after_bytes=$(get_path_size_bytes "$VAR_TMP_DIR" 1)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    record_stage_result "vartmp" "/var/tmp" "$before_bytes" "$after_bytes" "SUCCESS" ""
}

# Stage 8: Traditional /var/log
do_clean_traditional_logs() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning Traditional System Logs"
    print_info "Target: ${C_BOLD}${VAR_LOG_DIR}${C_RESET} (Archived / Rotated logs)"

    local before_bytes
    before_bytes=$(get_path_size_bytes "$VAR_LOG_DIR" 1)
    echo -e "  Before (Total /var/log): ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    print_info "Safety guards active:"
    print_info "  • /var/log/journal is EXCLUDED (managed separately via journalctl)"
    print_info "  • pacman.log, wtmp, btmp, lastlog, audit logs are PRESERVED"
    print_info "  • Only rotated/archived files (*.gz, *.1, *.old, *.xz, *.zst) and stale /var/log/old/ are targeted"

    # Find rotated files
    local rotated_files=()
    while IFS= read -r -d $'\0' file; do
        # Ensure not in journal directory
        if [[ "$file" =~ ^/var/log/journal ]]; then
            continue
        fi
        rotated_files+=("$file")
    done < <(sudo find "$VAR_LOG_DIR" -type f \( -name "*.gz" -o -name "*.old" -o -name "*.1" -o -name "*.log.1" -o -name "*.xz" -o -name "*.zst" -o -name "*.[0-9]" \) -print0 2>/dev/null)

    print_info "Found ${#rotated_files[@]} rotated log archives."

    if (( ${#rotated_files[@]} > 0 )); then
        print_clean "Removing rotated log archives..."
        for rfile in "${rotated_files[@]}"; do
            sudo rm -f "$rfile" 2>/dev/null || true
        done
    fi

    # Clean /var/log/old if it exists
    if [[ -d "/var/log/old" ]]; then
        print_clean "Cleaning /var/log/old directory contents..."
        sudo find "/var/log/old" -mindepth 1 -type f -delete 2>/dev/null || true
    fi

    local after_bytes
    after_bytes=$(get_path_size_bytes "$VAR_LOG_DIR" 1)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    print_done "Traditional log rotation archives cleaned."
    record_stage_result "tradlogs" "Traditional Logs" "$before_bytes" "$after_bytes" "SUCCESS" ""
}

# Stage 9: systemd Journal
do_clean_journal() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Cleaning systemd Journal"
    print_info "Using native ${C_BOLD}journalctl --vacuum-*${C_RESET} commands."

    local before_bytes
    before_bytes=$(get_journal_size_bytes)
    echo -e "  Before: ${C_BOLD}$(format_bytes "$before_bytes")${C_RESET}"

    echo ""
    echo "Select Journal Vacuum Policy:"
    echo -e "  ${C_BOLD}1)${C_RESET} Conservative : Retain last 14 days / vacuum to 200M (Recommended)"
    echo -e "  ${C_BOLD}2)${C_RESET} Moderate     : Retain last 7 days / vacuum to 100M"
    echo -e "  ${C_BOLD}3)${C_RESET} Aggressive   : Vacuum size to 1M (Minimal history retained)"
    echo -e "  ${C_BOLD}4)${C_RESET} Skip journal vacuum"

    local choice="1"
    if [[ "$BATCH_CONFIRM_ALL" -eq 1 ]]; then
        echo -e "${C_DIM}Batch mode: Selecting Option 1 (Conservative)${C_RESET}"
        choice="1"
    else
        read -rp "Select [1-4] (default 1): " user_choice
        choice="${user_choice:-1}"
    fi

    case "$choice" in
        1)
            print_clean "Running conservative vacuum: --vacuum-time=14d --vacuum-size=200M..."
            sudo journalctl --vacuum-time=14d >/dev/null 2>&1 || true
            sudo journalctl --vacuum-size=200M >/dev/null 2>&1 || true
            ;;
        2)
            print_clean "Running moderate vacuum: --vacuum-time=7d --vacuum-size=100M..."
            sudo journalctl --vacuum-time=7d >/dev/null 2>&1 || true
            sudo journalctl --vacuum-size=100M >/dev/null 2>&1 || true
            ;;
        3)
            print_warn "Aggressive vacuum selected. Very little historical log data will remain."
            if prompt_confirm "Confirm aggressive journal vacuum (--vacuum-size=1M)?" "N"; then
                print_clean "Running aggressive vacuum: --vacuum-size=1M..."
                sudo journalctl --vacuum-size=1M >/dev/null 2>&1 || true
            else
                print_skip "Aggressive vacuum cancelled."
                record_stage_result "journal" "systemd Journal" "$before_bytes" "$before_bytes" "SKIPPED" "Cancelled by user"
                return 0
            fi
            ;;
        4)
            print_skip "Journal vacuum skipped."
            record_stage_result "journal" "systemd Journal" "$before_bytes" "$before_bytes" "SKIPPED" "Skipped by user"
            return 0
            ;;
        *)
            print_warn "Invalid selection. Skipping journal vacuum."
            record_stage_result "journal" "systemd Journal" "$before_bytes" "$before_bytes" "SKIPPED" "Invalid input"
            return 0
            ;;
    esac

    local after_bytes
    after_bytes=$(get_journal_size_bytes)
    local reclaimed=0
    (( before_bytes > after_bytes )) && reclaimed=$(( before_bytes - after_bytes ))

    echo -e "  After:     ${C_BOLD}$(format_bytes "$after_bytes")${C_RESET}"
    echo -e "  Reclaimed: ${C_GREEN}${C_BOLD}$(format_bytes "$reclaimed")${C_RESET}"

    print_done "Journal vacuum completed."
    record_stage_result "journal" "systemd Journal" "$before_bytes" "$after_bytes" "SUCCESS" ""
}

# Stage 10: Snapper Snapshot Review & Cleanup
do_clean_snapper() {
    local stage_num="${1:-}"
    local prefix=""
    [[ -n "$stage_num" ]] && prefix="[ $stage_num ] "

    print_section "${prefix}Review & Clean Snapper Snapshots"

    if ! command -v snapper >/dev/null 2>&1; then
        print_skip "Snapper is not installed."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SKIPPED" "Snapper not installed"
        return 0
    fi

    local configs
    configs=$(snapper list-configs 2>/dev/null | awk 'NR>2 {print $1}')
    if [[ -z "$configs" ]]; then
        print_skip "No Snapper configurations found."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SKIPPED" "No Snapper config"
        return 0
    fi

    local cfg="root"
    if ! echo "$configs" | grep -q "^root$"; then
        cfg=$(echo "$configs" | head -n 1)
    fi

    print_info "Querying Snapper snapshots for config '${C_BOLD}${cfg}${C_RESET}'..."
    local raw_list
    raw_list=$(sudo snapper -c "$cfg" list 2>/dev/null)

    if [[ -z "$raw_list" ]]; then
        print_warn "Could not read snapshots or permission error."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "FAILED" "Failed to query snapper list"
        return 0
    fi

    # Parse snapshots
    echo ""
    echo -e "${C_BOLD}Current Snapper Snapshots (${cfg}):${C_RESET}"
    echo "$raw_list" | head -n 2
    echo -e "${C_GRAY}────────────────────────────────────────────────────────────────────${C_RESET}"

    local removable_ids=()
    local snap_lines
    snap_lines=$(echo "$raw_list" | awk 'NR>2')

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local id
        id=$(echo "$line" | awk '{print $1}' | tr -d '#' | tr -d '+')

        if [[ "$id" == "0" ]]; then
            echo -e "${line}  ${C_GREEN}${C_BOLD}[PROTECTED - CURRENT SYSTEM]${C_RESET}"
        else
            echo "$line"
            if [[ "$id" =~ ^[0-9]+$ ]]; then
                removable_ids+=("$id")
            fi
        fi
    done <<< "$snap_lines"

    echo ""
    if (( ${#removable_ids[@]} == 0 )); then
        print_skip "No removable Snapper snapshots found (only snapshot 0 exists)."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SKIPPED" "Only protected snapshot 0 present"
        return 0
    fi

    print_info "Removable snapshots available: ${C_BOLD}${removable_ids[*]}${C_RESET}"
    print_warn "Snapshot 0 is strictly protected and will NEVER be deleted."

    echo ""
    echo "Options:"
    echo "  • Enter snapshot numbers to delete (e.g. 3, 5 or 2-4)"
    echo "  • Type 'all' to delete all removable non-zero snapshots"
    echo "  • Type 'skip' or press Enter to skip snapshot deletion"
    echo -ne "${C_YELLOW}Your selection:${C_RESET} "

    local selection
    if [[ "$BATCH_CONFIRM_ALL" -eq 1 ]]; then
        echo -e "${C_DIM}Batch mode: Snapper snapshot deletion requires manual selection. Skipping.${C_RESET}"
        selection="skip"
    else
        read -r selection
    fi
    selection="${selection:-skip}"

    if [[ "${selection,,}" == "skip" || "${selection,,}" == "none" ]]; then
        print_skip "Snapper snapshot cleanup skipped by user."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SKIPPED" "Skipped by user"
        return 0
    fi

    local target_ids=()
    if [[ "${selection,,}" == "all" ]]; then
        target_ids=("${removable_ids[@]}")
    else
        # Parse ranges (e.g., 2-5) and comma-separated IDs (e.g. 2, 4, 6)
        IFS=',' read -ra tokens <<< "$selection"
        for tok in "${tokens[@]}"; do
            tok=$(echo "$tok" | tr -d ' ')
            if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                local start="${BASH_REMATCH[1]}"
                local end="${BASH_REMATCH[2]}"
                for (( s=start; s<=end; s++ )); do
                    target_ids+=("$s")
                done
            elif [[ "$tok" =~ ^[0-9]+$ ]]; then
                target_ids+=("$tok")
            fi
        done
    fi

    # Filter & validate target IDs
    local valid_targets=()
    for tid in "${target_ids[@]}"; do
        if [[ "$tid" == "0" ]]; then
            print_error "Rejected attempt to delete snapshot 0. Snapshot 0 is protected."
            continue
        fi
        # Verify it exists in removable_ids
        local found=0
        for rid in "${removable_ids[@]}"; do
            if [[ "$rid" == "$tid" ]]; then
                found=1
                break
            fi
        done

        if [[ $found -eq 1 ]]; then
            valid_targets+=("$tid")
        else
            print_warn "Snapshot $tid is not in the list of removable snapshots. Skipping."
        fi
    done

    if (( ${#valid_targets[@]} == 0 )); then
        print_skip "No valid non-zero snapshots selected."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SKIPPED" "No valid snapshots chosen"
        return 0
    fi

    # Deduplicate targets
    local unique_targets
    unique_targets=$(printf "%s\n" "${valid_targets[@]}" | sort -n -u | tr '\n' ' ')

    print_warn "You are about to delete Snapper snapshot(s): ${C_BOLD}${unique_targets}${C_RESET}"
    if ! prompt_confirm "Proceed with deleting these snapshot(s)?" "N"; then
        print_skip "Snapshot deletion aborted by user."
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SKIPPED" "Aborted by user"
        return 0
    fi

    local del_success=0
    local del_fail=0
    for sid in $unique_targets; do
        print_clean "Deleting Snapper snapshot #${sid}..."
        if sudo snapper -c "$cfg" delete "$sid" 2>/dev/null; then
            print_done "Snapshot #${sid} deleted."
            del_success=$(( del_success + 1 ))
        else
            print_error "Failed to delete snapshot #${sid}."
            del_fail=$(( del_fail + 1 ))
        fi
    done

    if (( del_fail > 0 )); then
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "PARTIAL" "Deleted ${del_success}, failed ${del_fail}"
    else
        record_stage_result "snapper" "Snapper Snapshots" 0 0 "SUCCESS" "Deleted ${del_success} snapshots"
    fi
}

# ------------------------------------------------------------------------------
# 8. Full Cleanup Flow
# ------------------------------------------------------------------------------
do_full_cleanup() {
    print_header "Option 11: Run Full System Cleanup Sequence"

    echo "Select execution mode:"
    echo -e "  ${C_BOLD}1)${C_RESET} Confirm each stage (Interactive step-by-step)"
    echo -e "  ${C_BOLD}2)${C_RESET} Confirm all         (Batch mode with standard defaults)"
    echo -e "  ${C_BOLD}3)${C_RESET} Cancel"
    read -rp "Select [1-3] (default 1): " mode_choice
    mode_choice="${mode_choice:-1}"

    case "$mode_choice" in
        1)
            BATCH_CONFIRM_ALL=0
            ;;
        2)
            BATCH_CONFIRM_ALL=1
            print_info "Batch mode enabled: non-destructive prompts will be pre-approved."
            ;;
        3)
            echo "Full cleanup cancelled."
            return 0
            ;;
        *)
            echo "Invalid option. Defaulting to interactive mode."
            BATCH_CONFIRM_ALL=0
            ;;
    esac

    # Initial measurements
    print_info "Capturing initial system state..."
    show_system_overview

    # Sequential execution:
    # 1. Coredumps
    # 2. Pacman cache
    # 3. User cache
    # 4. Trash
    # 5. /tmp
    # 6. /var/tmp
    # 7. Traditional /var/log
    # 8. systemd journal
    # 9. Snapper snapshots

    do_clean_coredumps "1/9"
    do_clean_pacman_cache "2/9"
    do_clean_user_cache "3/9"
    do_clean_trash "4/9"
    do_clean_tmp "5/9"
    do_clean_var_tmp "6/9"
    do_clean_traditional_logs "7/9"
    do_clean_journal "8/9"
    do_clean_snapper "9/9"

    # Reset batch flag
    BATCH_CONFIRM_ALL=0

    # Render summary
    show_final_summary
}

# ------------------------------------------------------------------------------
# 9. Final Summary Report & Accounting
# ------------------------------------------------------------------------------
show_final_summary() {
    print_header "System Cleanup Final Report"

    if (( ${#STAGE_KEYS[@]} == 0 )); then
        print_info "No cleanup operations were performed during this session."
        return
    fi

    local total_before=0
    local total_after=0
    local total_reclaimed=0
    local count_success=0
    local count_partial=0
    local count_skipped=0
    local count_failed=0

    echo -e "${C_BOLD}┌──────────────────────┬────────────┬────────────┬────────────┬───────────┐${C_RESET}"
    echo -e "${C_BOLD}│ Category             │ Before     │ After      │ Reclaimed  │ Status    │${C_RESET}"
    echo -e "${C_BOLD}├──────────────────────┼────────────┼────────────┼────────────┼───────────┤${C_RESET}"

    for k in "${STAGE_KEYS[@]}"; do
        local lbl="${STAGE_LABELS[$k]}"
        local b="${STAGE_BEFORE[$k]}"
        local a="${STAGE_AFTER[$k]}"
        local r="${STAGE_RECLAIMED[$k]}"
        local st="${STAGE_STATUS[$k]}"

        total_before=$(( total_before + b ))
        total_after=$(( total_after + a ))
        total_reclaimed=$(( total_reclaimed + r ))

        local color_code=""
        case "$st" in
            SUCCESS)
                color_code="${C_GREEN}"
                count_success=$(( count_success + 1 ))
                ;;
            PARTIAL)
                color_code="${C_YELLOW}"
                count_partial=$(( count_partial + 1 ))
                ;;
            SKIPPED)
                color_code="${C_GRAY}"
                count_skipped=$(( count_skipped + 1 ))
                ;;
            FAILED)
                color_code="${C_RED}"
                count_failed=$(( count_failed + 1 ))
                ;;
        esac

        printf "│ %-20s │ %10s │ %10s │ %10s │ %b%-9s%b │\n" \
            "$lbl" "$(format_bytes "$b")" "$(format_bytes "$a")" "$(format_bytes "$r")" "$color_code" "$st" "$C_RESET"
    done

    echo -e "${C_BOLD}├──────────────────────┼────────────┼────────────┼────────────┼───────────┤${C_RESET}"
    printf "│ %-20s │ %10s │ %10s │ ${C_GREEN}%10s${C_RESET} │ %-9s │\n" \
        "TOTAL ACROSS STAGES" "$(format_bytes "$total_before")" "$(format_bytes "$total_after")" "$(format_bytes "$total_reclaimed")" ""
    echo -e "${C_BOLD}└──────────────────────┴────────────┴────────────┴────────────┴───────────┘${C_RESET}"

    echo ""
    echo -e "${C_BOLD}Operation Statistics:${C_RESET}"
    printf "  • ${C_GREEN}Successful${C_RESET} : %d\n" "$count_success"
    printf "  • ${C_YELLOW}Partial${C_RESET}    : %d\n" "$count_partial"
    printf "  • ${C_GRAY}Skipped${C_RESET}    : %d\n" "$count_skipped"
    printf "  • ${C_RED}Failed${C_RESET}     : %d\n" "$count_failed"

    # Print issues if any
    local has_issues=0
    for k in "${STAGE_KEYS[@]}"; do
        local st="${STAGE_STATUS[$k]}"
        local notes="${STAGE_NOTES[$k]}"
        if [[ "$st" == "PARTIAL" || "$st" == "FAILED" ]]; then
            if [[ $has_issues -eq 0 ]]; then
                echo ""
                echo -e "${C_BOLD}Detailed Notices & Warnings:${C_RESET}"
                has_issues=1
            fi
            echo -e "  [${STAGE_LABELS[$k]}]: ${notes}"
        fi
    done
}

# ------------------------------------------------------------------------------
# 10. Exit & BleachBit Handoff
# ------------------------------------------------------------------------------
handle_exit_and_bleachbit() {
    print_section "Exit & Application Handoff"

    local bleachbit_bin
    bleachbit_bin=$(command -v bleachbit 2>/dev/null || true)

    if [[ -n "$bleachbit_bin" ]]; then
        echo "Options:"
        echo "  1) Exit to shell"
        echo "  2) Launch BleachBit GUI (${bleachbit_bin})"
        echo "  3) Return to main menu"
        read -rp "Select [1-3] (default 1): " exit_choice
        exit_choice="${exit_choice:-1}"

        case "$exit_choice" in
            2)
                print_info "Launching BleachBit..."
                nohup "$bleachbit_bin" >/dev/null 2>&1 &
                print_done "BleachBit launched."
                exit 0
                ;;
            3)
                return 0
                ;;
            *)
                echo "Exiting system-cleanup. Have a great day!"
                exit 0
                ;;
        esac
    else
        echo "Options:"
        echo "  1) Exit to shell"
        echo "  2) Return to main menu"
        read -rp "Select [1-2] (default 1): " exit_choice
        exit_choice="${exit_choice:-1}"

        if [[ "$exit_choice" == "2" ]]; then
            return 0
        else
            echo "Exiting system-cleanup. Have a great day!"
            exit 0
        fi
    fi
}

# ------------------------------------------------------------------------------
# 11. Main Menu Loop
# ------------------------------------------------------------------------------
main_menu() {
    while true; do
        print_header "Arch Linux Maintenance: System Cleanup"

        echo -e "  ${C_CYAN}1.${C_RESET}  Review cleanup targets (Dry-run inspection)"
        echo -e "  ${C_CYAN}2.${C_RESET}  Clean coredumps (/var/lib/systemd/coredump)"
        echo -e "  ${C_CYAN}3.${C_RESET}  Clean pacman package cache (/var/cache/pacman/pkg)"
        echo -e "  ${C_CYAN}4.${C_RESET}  Clean user cache (~/.cache)"
        echo -e "  ${C_CYAN}5.${C_RESET}  Clean user trash (~/.local/share/Trash)"
        echo -e "  ${C_CYAN}6.${C_RESET}  Clean temporary files (/tmp)"
        echo -e "  ${C_CYAN}7.${C_RESET}  Clean persistent temp (/var/tmp)"
        echo -e "  ${C_CYAN}8.${C_RESET}  Clean traditional system logs (/var/log rotated)"
        echo -e "  ${C_CYAN}9.${C_RESET}  Clean systemd journal (journalctl vacuum)"
        echo -e "  ${C_CYAN}10.${C_RESET} Review/remove Snapper snapshots"
        echo -e "  ${C_CYAN}11.${C_RESET} ${C_BOLD}Run full cleanup sequence${C_RESET}"
        echo -e "  ${C_CYAN}12.${C_RESET} Exit"
        echo ""

        read -rp "Select an option [1-12]: " menu_choice
        case "$menu_choice" in
            1)
                do_review_overview
                ;;
            2)
                do_clean_coredumps
                ;;
            3)
                do_clean_pacman_cache
                ;;
            4)
                do_clean_user_cache
                ;;
            5)
                do_clean_trash
                ;;
            6)
                do_clean_tmp
                ;;
            7)
                do_clean_var_tmp
                ;;
            8)
                do_clean_traditional_logs
                ;;
            9)
                do_clean_journal
                ;;
            10)
                do_clean_snapper
                ;;
            11)
                do_full_cleanup
                ;;
            12|q|Q|exit)
                handle_exit_and_bleachbit
                ;;
            *)
                print_error "Invalid selection. Please choose an option between 1 and 12."
                ;;
        esac

        echo ""
        read -rp "Press Enter to return to menu..." _dummy || true
    done
}

# ------------------------------------------------------------------------------
# 12. Script Entry Point
# ------------------------------------------------------------------------------
main() {
    # Check flags for CLI dry-run or help
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: ${SCRIPT_NAME} [OPTIONS]"
        echo ""
        echo "Interactive Arch Linux maintenance and cleanup script."
        echo ""
        echo "Options:"
        echo "  -h, --help      Display this help menu"
        echo "  -d, --dry-run   Run target inspection and exit without changes"
        echo "  -v, --version   Display version information"
        exit 0
    elif [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
        echo "${SCRIPT_NAME} version ${SCRIPT_VERSION}"
        exit 0
    fi

    # Initialize single sudo authentication
    init_sudo_auth

    # Handle direct dry-run CLI argument
    if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-d" ]]; then
        do_review_overview
        exit 0
    fi

    # Display initial overview
    show_system_overview

    # Enter interactive menu
    main_menu
}

main "$@"
