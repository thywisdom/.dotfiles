#!/usr/bin/env bash
# ==============================================================================
# custom-system-cleanup v2.0.0 — Arch Linux Streamlined System Maintenance
# ==============================================================================
# UI    : gum (Charmbracelet) — pre-themed Catppuccin Mocha via Omarchy env
# Flow  : inspect (dry-run) → single confirm → execute stages → summary
# Ref   : ~/dotfiles/TUI_reference.md
# Rule  : Hyprland floats this terminal via windowrules.lua L15
# ==============================================================================

set -uo pipefail

# Hyprland window rule: ^((custom|user)-scripts?)$ → float 1350×708 centered
export WAYLAND_APP_ID="custom-scripts"

# ── Constants ──────────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="custom-system-cleanup"
readonly SCRIPT_VERSION="2.0.0"
readonly PACMAN_CACHE="/var/cache/pacman/pkg"
readonly COREDUMP_DIR="/var/lib/systemd/coredump"
readonly USER_CACHE="${HOME}/.cache"
readonly USER_TRASH="${HOME}/.local/share/Trash"
readonly VAR_LOG="/var/log"
readonly JOURNAL_DIR="/var/log/journal"

# ── Mutable state ─────────────────────────────────────────────────────────────
SUDO_KEEPALIVE_PID=""
DRY=0     # --dry-run/-d: inspect only, no changes

# Stage accounting
declare -a  SK=()
declare -A  SL=()  # label
declare -A  SB=()  # before bytes
declare -A  SA=()  # after bytes
declare -A  SF=()  # freed bytes
declare -A  SS=()  # status
declare -A  SN=()  # notes

# ── Exit / Signal traps ────────────────────────────────────────────────────────
_on_exit() {
    local code=$?
    tput cnorm 2>/dev/null || true
    [[ -n "${SUDO_KEEPALIVE_PID:-}" ]] && kill "${SUDO_KEEPALIVE_PID}" 2>/dev/null || true
    exit "${code}"
}
trap '_on_exit' EXIT INT TERM HUP

# ── Sudo: single auth + background keepalive (Omarchy pattern) ────────────────
init_sudo() {
    if [[ ${EUID} -eq 0 ]]; then
        gum log --level error "Do not run as root. Use a regular user with sudo privileges."
        exit 1
    fi
    if ! command -v sudo &>/dev/null; then
        gum log --level error "'sudo' not found in PATH."
        exit 1
    fi
    if ! sudo -v -p "[sudo] password for %u: "; then
        gum log --level error "Sudo authentication failed."
        exit 1
    fi
    # Keepalive: ping sudo every 60 s while this process lives
    while true; do sudo -n true; sleep 60; done 2>/dev/null &
    SUDO_KEEPALIVE_PID=$!
}

# ── Helpers ───────────────────────────────────────────────────────────────────
fmt_bytes() {
    local b="${1:-0}"
    [[ ! "${b}" =~ ^[0-9]+$ ]] && echo "0 B" && return
    awk -v b="${b}" 'BEGIN {
        if      (b <       1024) printf "%d B",     b
        else if (b <    1048576) printf "%.1f KiB", b/1024
        else if (b < 1073741824) printf "%.2f MiB", b/1048576
        else                     printf "%.2f GiB", b/1073741824
    }'
}

get_size() {
    local path="${1}" use_sudo="${2:-0}"
    [[ ! -e "${path}" ]] && echo 0 && return
    local s=0
    if (( use_sudo )); then
        s=$(sudo du -s --block-size=1 "${path}" 2>/dev/null | awk '{print $1}') || s=0
    else
        s=$(du -s --block-size=1 "${path}" 2>/dev/null | awk '{print $1}') || s=0
    fi
    echo "${s:-0}"
}

get_journal_size() {
    if [[ -d "${JOURNAL_DIR}" ]]; then
        get_size "${JOURNAL_DIR}" 1
    elif [[ -d "/run/log/journal" ]]; then
        get_size "/run/log/journal" 1
    else
        echo 0
    fi
}

record() {
    # record <key> <label> <before> <after> <STATUS> [note]
    local key="${1}" label="${2}" before="${3}" after="${4}" status="${5}" note="${6:-}"
    local freed=0
    if (( before > after )); then
        freed=$(( before - after ))
    fi
    SK+=("${key}")
    SL["${key}"]="${label}"
    SB["${key}"]="${before}"
    SA["${key}"]="${after}"
    SF["${key}"]="${freed}"
    SS["${key}"]="${status}"
    SN["${key}"]="${note}"
}

section() {
    # section <n> <total> <title>
    echo
    gum style --foreground "#89b4fa" --bold "── [${1}/${2}]  ${3}"
}

# ── Phase 1: Inspect / Dry-run ────────────────────────────────────────────────
phase_inspect() {
    clear

    # ── Banner ────────────────────────────────────────────────────────────────
    gum style \
        --border rounded \
        --border-foreground "#89b4fa" \
        --padding "1 3" \
        "$(gum style --bold --foreground '#cdd6f4' "  Arch Linux System Cleanup  v${SCRIPT_VERSION}")" \
        "" \
        "  $(uname -n)  ·  ${USER}  ·  kernel $(uname -r)"

    # ── Disk usage ────────────────────────────────────────────────────────────
    echo
    gum style --foreground "#89b4fa" --bold "Disk Usage"

    local root_src home_src
    root_src=$(df --output=source / 2>/dev/null | tail -1) || root_src=""
    home_src=$(df --output=source "${HOME}" 2>/dev/null | tail -1) || home_src=""

    df -h / 2>/dev/null | awk 'NR==2 {
        printf "  %-8s  %s used / %s total  (%s avail  %s)\n", $6, $3, $2, $4, $5
    }'
    if [[ "${home_src}" != "${root_src}" ]]; then
        df -h "${HOME}" 2>/dev/null | awk 'NR==2 {
            printf "  %-8s  %s used / %s total  (%s avail  %s)\n", $6, $3, $2, $4, $5
        }'
    fi

    # ── Scan targets ──────────────────────────────────────────────────────────
    echo
    gum style --foreground "#585b70" "Scanning cleanup targets — no changes made..."
    echo

    local sz_core sz_pacman sz_ucache sz_trash sz_tmp sz_vartmp sz_tradlog sz_journal
    sz_core=$(get_size "${COREDUMP_DIR}" 1)
    sz_pacman=$(get_size "${PACMAN_CACHE}" 1)
    sz_ucache=$(get_size "${USER_CACHE}" 0)
    sz_trash=$(get_size "${USER_TRASH}" 0)
    sz_tmp=$(get_size "/tmp" 1)
    sz_vartmp=$(get_size "/var/tmp" 1)
    sz_journal=$(get_journal_size)
    local total_log; total_log=$(get_size "${VAR_LOG}" 1)
    if (( total_log > sz_journal )); then
        sz_tradlog=$(( total_log - sz_journal ))
    else
        sz_tradlog=0
    fi

    # Orphan count
    local orphan_list orphan_count=0
    orphan_list=$(pacman -Qdtq 2>/dev/null) || orphan_list=""
    [[ -n "${orphan_list}" ]] && orphan_count=$(echo "${orphan_list}" | wc -l)

    # Snapper info
    local snap_total=0 snap_removable=0
    if command -v snapper &>/dev/null; then
        local cfgs; cfgs=$(snapper list-configs 2>/dev/null | awk 'NR>2 {print $1}') || cfgs=""
        for c in ${cfgs}; do
            local snaps; snaps=$(sudo snapper -c "${c}" list 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9]+$/' ) || snaps=""
            if [[ -n "${snaps}" ]]; then
                local sc; sc=$(echo "${snaps}" | wc -l)
                snap_total=$(( snap_total + sc ))
                local rc; rc=$(echo "${snaps}" | awk '$1 != "0"' | wc -l)
                snap_removable=$(( snap_removable + rc ))
            fi
        done
    fi

    # ── Inspect table (static display with --print) ───────────────────────────
    {
        printf "Module,Target Path,Current Size,Risk,Mode\n"
        _irow "Coredumps"    "${COREDUMP_DIR}"        "${sz_core}"    "Safe"    "Auto"    "${COREDUMP_DIR}"
        _irow "Pacman Cache" "${PACMAN_CACHE}"         "${sz_pacman}"  "⚠ High"  "Confirm" "${PACMAN_CACHE}"
        _irow "User Cache"   "~/.cache"               "${sz_ucache}"  "Medium"  "Auto"    "${USER_CACHE}"
        _irow "Trash"        "~/.local/share/Trash"   "${sz_trash}"   "⚠ High"  "Confirm" "${USER_TRASH}"
        _irow "/tmp"         "/tmp  (stale >1d)"       "${sz_tmp}"     "Safe"    "Auto"    "/tmp"
        _irow "/var/tmp"     "/var/tmp  (stale >7d)"   "${sz_vartmp}"  "Safe"    "Auto"    "/var/tmp"
        _irow "Log Archives" "/var/log (rotated)"      "${sz_tradlog}" "Safe"    "Auto"    "${VAR_LOG}"
        printf "Journal,journalctl vacuum,→ 1M (aggressive),Medium,Auto\n"
        printf "Orphan Pkgs,pacman -Rns,${orphan_count} package(s),Medium,Auto\n"
        if command -v snapper &>/dev/null; then
            printf "Snapper,Btrfs snapshots,${snap_removable} removable / ${snap_total} total,⚠ High,Confirm\n"
        else
            printf "Snapper,Btrfs snapshots,N/A — not installed,—,Skip\n"
        fi
    } | gum table --print --widths "14,26,20,9,8"

    echo
    local total_est=$(( sz_core + sz_pacman + sz_ucache + sz_trash + sz_vartmp + sz_tradlog + sz_journal ))
    gum style \
        --foreground "#a6e3a1" \
        --bold \
        "  Estimated freeable: $(fmt_bytes "${total_est}")"
    gum style \
        --foreground "#585b70" \
        "  (Actual reclaimed depends on pacman cache contents, active file locks, journal retention)"

    # ── Access warnings (shown before confirm) ────────────────────────────────
    echo
    _warn_access "${COREDUMP_DIR}"  "Coredump dir"
    _warn_access "${PACMAN_CACHE}"  "Pacman cache"
    _warn_access "${USER_CACHE}"    "User cache"
    _warn_access "${USER_TRASH}"    "User trash"
}

_irow() {
    local label="${1}" display_path="${2}" sz="${3}" risk="${4}" mode="${5}" real_path="${6}"
    if [[ ! -e "${real_path}" ]]; then
        printf "%s,%s,Not found,—,Skip\n" "${label}" "${display_path}"
    else
        printf "%s,%s,%s,%s,%s\n" "${label}" "${display_path}" "$(fmt_bytes "${sz}")" "${risk}" "${mode}"
    fi
}

_warn_access() {
    local path="${1}" label="${2}"
    if [[ ! -e "${path}" ]]; then
        gum log --level warn "${label} not found: ${path}"
        return 0
    fi
    if [[ ! -r "${path}" ]]; then
        gum log --level error "Permission denied: ${path} — stage will be skipped"
    fi
}

# ── Stage 1: Coredumps ────────────────────────────────────────────────────────
stage_coredumps() {
    section 1 10 "Coredumps"
    local before; before=$(get_size "${COREDUMP_DIR}" 1)
    gum log --level info "Path: ${COREDUMP_DIR}  ·  Before: $(fmt_bytes "${before}")"

    if [[ ! -d "${COREDUMP_DIR}" ]]; then
        gum log --level warn "Directory not found — skipping"
        record coredumps "Coredumps" "${before}" "${before}" SKIPPED "Dir not found"
        return 0
    fi

    local count; count=$(sudo find "${COREDUMP_DIR}" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | wc -l)
    if (( count == 0 )); then
        gum log --level info "No coredump files — already clean"
        record coredumps "Coredumps" "${before}" "${before}" SKIPPED "Already clean"
        return 0
    fi

    gum log --level info "Found ${count} coredump file(s)"

    local err=0
    if ! sudo find "${COREDUMP_DIR}" -mindepth 1 -maxdepth 1 -type f -delete 2>/dev/null; then
        err=1
        gum log --level warn "Standard delete failed — trying fallback (exec rm -f)..."
        if ! sudo find "${COREDUMP_DIR}" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} + 2>/dev/null; then
            err=2
        fi
    fi

    local after; after=$(get_size "${COREDUMP_DIR}" 1)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "After: $(fmt_bytes "${after}")  ·  Reclaimed: $(fmt_bytes "${freed}")"
    gum log --level debug "coredumpctl list may show COREFILE=missing — journal metadata is preserved (normal)"

    if (( err == 2 )); then
        record coredumps "Coredumps" "${before}" "${after}" PARTIAL "Some files could not be removed"
    else
        record coredumps "Coredumps" "${before}" "${after}" SUCCESS ""
    fi
}

# ── Stage 2: Pacman Package Cache ─────────────────────────────────────────────
stage_pacman() {
    section 2 10 "Pacman Package Cache"
    local before; before=$(get_size "${PACMAN_CACHE}" 1)
    gum log --level info "Path: ${PACMAN_CACHE}  ·  Before: $(fmt_bytes "${before}")"

    if [[ ! -d "${PACMAN_CACHE}" ]]; then
        gum log --level warn "Cache directory not found — skipping"
        record pacman "Pacman Cache" "${before}" "${before}" SKIPPED "Dir not found"
        return 0
    fi

    # Always confirm — this is the most destructive single operation
    echo
    gum style \
        --border normal \
        --border-foreground "#f9e2af" \
        --padding "1 2" \
        "$(gum style --foreground '#f9e2af' --bold '⚠  Full Pacman Cache Removal')" \
        "" \
        "  pacman -Scc --noconfirm removes ALL cached packages ($(fmt_bytes "${before}"))." \
        "  Rollbacks and reinstalls will require fresh downloads after this." \
        "  Residual download-* directories will also be cleared."
    echo

    if ! gum confirm "Remove entire pacman cache?"; then
        gum log --level info "Pacman cache cleanup skipped"
        record pacman "Pacman Cache" "${before}" "${before}" SKIPPED "Declined"
        return 0
    fi

    local plog; plog=$(mktemp /tmp/cleanup-pacman.XXXXXX)
    gum spin --spinner dot --title "pacman -Scc --noconfirm..." -- \
        bash -c "sudo pacman -Scc --noconfirm > '${plog}' 2>&1" || {
        gum log --level warn "pacman -Scc returned non-zero exit"
        grep -i "error" "${plog}" 2>/dev/null | head -5 || true
    }

    if command -v yay &>/dev/null; then
        gum spin --spinner dot --title "yay -Scc --noconfirm (AUR & yay cache)..." -- \
            bash -c "yay -Scc --noconfirm >> '${plog}' 2>&1" || {
            gum log --level warn "yay -Scc returned non-zero exit"
            grep -i "error" "${plog}" 2>/dev/null | head -5 || true
        }
    fi
    rm -f "${plog}"

    # Fallback: residual download-* dirs (known pacman bug: "Is a directory" error)
    local ddir_count
    ddir_count=$(sudo find "${PACMAN_CACHE}" -mindepth 1 -maxdepth 1 -type d -name "download-*" 2>/dev/null | wc -l) || ddir_count=0
    if (( ddir_count > 0 )); then
        gum log --level warn "Found ${ddir_count} residual download-* dir(s) — removing..."
        sudo find "${PACMAN_CACHE}" -mindepth 1 -maxdepth 1 -type d -name "download-*" \
            -exec rm -rf {} + 2>/dev/null || true
        gum log --level info "Residual download-* directories cleared"
    fi

    local after; after=$(get_size "${PACMAN_CACHE}" 1)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "After: $(fmt_bytes "${after}")  ·  Reclaimed: $(fmt_bytes "${freed}")"
    record pacman "Pacman Cache" "${before}" "${after}" SUCCESS ""
}

# ── Stage 3: User Cache ───────────────────────────────────────────────────────
stage_user_cache() {
    section 3 10 "User Cache (~/.cache)"
    local before; before=$(get_size "${USER_CACHE}" 0)
    gum log --level info "Path: ~/.cache  ·  Before: $(fmt_bytes "${before}")"

    if [[ ! -d "${USER_CACHE}" ]]; then
        gum log --level warn "~/.cache not found — skipping"
        record ucache "User Cache" "${before}" "${before}" SKIPPED "Dir not found"
        return 0
    fi

    gum log --level debug "Apps safely regenerate caches on next launch"
    find "${USER_CACHE}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

    local after; after=$(get_size "${USER_CACHE}" 0)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "After: $(fmt_bytes "${after}")  ·  Reclaimed: $(fmt_bytes "${freed}")"
    record ucache "User Cache" "${before}" "${after}" SUCCESS ""
}

# ── Stage 4: User Trash ───────────────────────────────────────────────────────
stage_trash() {
    section 4 10 "User Trash"

    if [[ ! -d "${USER_TRASH}" ]]; then
        gum log --level warn "Trash directory not found — skipping"
        record trash "Trash" 0 0 SKIPPED "Dir not found"
        return 0
    fi

    local before; before=$(get_size "${USER_TRASH}" 0)
    local item_count; item_count=$(find "${USER_TRASH}" -mindepth 1 2>/dev/null | wc -l)

    if (( item_count == 0 )); then
        gum log --level info "Trash is already empty"
        record trash "Trash" "${before}" "${before}" SKIPPED "Already empty"
        return 0
    fi

    # Show Trash contents preview
    echo
    gum style --foreground "#585b70" "Contents (first 10 items):"
    if [[ -d "${USER_TRASH}/files" ]]; then
        find "${USER_TRASH}/files" -mindepth 1 -maxdepth 1 2>/dev/null | head -10 | \
            sed 's|.*/||' | while read -r name; do printf "  • %s\n" "${name}"; done
    fi
    if (( item_count > 10 )); then
        printf "  ... and %d more item(s)\n" $(( item_count - 10 ))
    fi

    # Always confirm — permanent deletion
    echo
    gum style \
        --border normal \
        --border-foreground "#f38ba8" \
        --padding "1 2" \
        "$(gum style --foreground '#f38ba8' --bold '⚠  Permanent Deletion — Cannot Be Undone')" \
        "" \
        "  ${item_count} item(s)  ·  $(fmt_bytes "${before}")" \
        "  Files will be permanently deleted and cannot be recovered."
    echo

    if ! gum confirm --default "Permanently empty Trash?"; then
        gum log --level info "Trash cleanup skipped"
        record trash "Trash" "${before}" "${before}" SKIPPED "Declined"
        return 0
    fi

    rm -rf "${USER_TRASH:?}"/* 2>/dev/null || true
    mkdir -p "${USER_TRASH}/files" "${USER_TRASH}/info" 2>/dev/null || true

    local after; after=$(get_size "${USER_TRASH}" 0)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "After: $(fmt_bytes "${after}")  ·  Reclaimed: $(fmt_bytes "${freed}")"
    record trash "Trash" "${before}" "${after}" SUCCESS ""
}

# ── Stage 5: /tmp ─────────────────────────────────────────────────────────────
stage_tmp() {
    section 5 10 "/tmp Cleanup"
    local before; before=$(get_size "/tmp" 1)
    gum log --level info "Path: /tmp  ·  Before: $(fmt_bytes "${before}")  ·  Pruning files older than 1 day"
    gum log --level debug "Preserved: sockets, X11/Wayland sockets, systemd-private dirs, active locks"

    if command -v systemd-tmpfiles &>/dev/null; then
        gum spin --spinner minidot --title "systemd-tmpfiles --clean..." -- \
            bash -c "sudo systemd-tmpfiles --clean 2>/dev/null; true"
    fi

    local removed=0 skipped=0
    while IFS= read -r -d $'\0' item; do
        local bname; bname=$(basename "${item}")

        # Strict exclusion list — active runtime artifacts
        case "${bname}" in
            .X11-unix|.ICE-unix|.font-unix|.XIM-unix|.Test-unix|\
            .X*-lock|sddm-auth-*|ssh-*|gpg-*|pipewire*|wayland-*|systemd-private-*)
                skipped=$(( skipped + 1 ))
                continue
                ;;
        esac

        # Skip sockets and named pipes (active IPC)
        if [[ -S "${item}" || -p "${item}" ]]; then
            skipped=$(( skipped + 1 ))
            continue
        fi

        if sudo rm -rf "${item}" 2>/dev/null; then
            removed=$(( removed + 1 ))
        else
            skipped=$(( skipped + 1 ))
        fi
    done < <(sudo find /tmp -mindepth 1 -maxdepth 1 -mtime +1 -print0 2>/dev/null)

    local after; after=$(get_size "/tmp" 1)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "Removed ${removed} stale item(s)  ·  Preserved ${skipped} active item(s)  ·  Reclaimed: $(fmt_bytes "${freed}")"
    record tmp "/tmp" "${before}" "${after}" SUCCESS ""
}

# ── Stage 6: /var/tmp ─────────────────────────────────────────────────────────
stage_var_tmp() {
    section 6 10 "/var/tmp Cleanup"
    local before; before=$(get_size "/var/tmp" 1)
    gum log --level info "Path: /var/tmp  ·  Before: $(fmt_bytes "${before}")  ·  Pruning files older than 7 days"
    gum log --level debug "/var/tmp persists across reboots by design; systemd-private dirs preserved"

    if command -v systemd-tmpfiles &>/dev/null; then
        gum spin --spinner minidot --title "systemd-tmpfiles --clean..." -- \
            bash -c "sudo systemd-tmpfiles --clean 2>/dev/null; true"
    fi

    local removed=0 skipped=0
    while IFS= read -r -d $'\0' item; do
        local bname; bname=$(basename "${item}")
        if [[ "${bname}" =~ ^systemd-private- ]]; then
            skipped=$(( skipped + 1 ))
            continue
        fi
        if sudo rm -rf "${item}" 2>/dev/null; then
            removed=$(( removed + 1 ))
        else
            skipped=$(( skipped + 1 ))
        fi
    done < <(sudo find /var/tmp -mindepth 1 -maxdepth 1 -mtime +7 -print0 2>/dev/null)

    local after; after=$(get_size "/var/tmp" 1)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "Removed ${removed}  ·  Preserved ${skipped}  ·  Reclaimed: $(fmt_bytes "${freed}")"
    record vartmp "/var/tmp" "${before}" "${after}" SUCCESS ""
}

# ── Stage 7: Traditional /var/log Archives ────────────────────────────────────
stage_trad_logs() {
    section 7 10 "Log Archives (/var/log rotated)"
    local before; before=$(get_size "${VAR_LOG}" 1)
    gum log --level info "/var/log total before: $(fmt_bytes "${before}")"
    gum log --level debug "Preserved: /var/log/journal, pacman.log, wtmp, btmp, lastlog, audit/"

    local rotated=()
    while IFS= read -r -d $'\0' f; do
        [[ "${f}" =~ ^/var/log/journal ]] && continue
        rotated+=("${f}")
    done < <(sudo find "${VAR_LOG}" -type f \
        \( -name "*.gz" -o -name "*.old" -o -name "*.1" -o -name "*.log.1" \
           -o -name "*.xz" -o -name "*.zst" -o -name "*.[0-9]" \) \
        -print0 2>/dev/null)

    gum log --level info "Found ${#rotated[@]} rotated archive(s)"

    local failed=0
    for f in "${rotated[@]}"; do
        sudo rm -f "${f}" 2>/dev/null || failed=$(( failed + 1 ))
    done

    # Clean /var/log/old if present
    if [[ -d "/var/log/old" ]]; then
        sudo find "/var/log/old" -mindepth 1 -type f -delete 2>/dev/null || true
    fi

    local after; after=$(get_size "${VAR_LOG}" 1)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "Removed ${#rotated[@]} archive(s)  ·  Reclaimed: $(fmt_bytes "${freed}")"

    if (( failed > 0 )); then
        record tradlogs "Log Archives" "${before}" "${after}" PARTIAL "${failed} file(s) could not be removed"
    else
        record tradlogs "Log Archives" "${before}" "${after}" SUCCESS ""
    fi
}

# ── Stage 8: systemd Journal Vacuum (Aggressive) ──────────────────────────────
stage_journal() {
    section 8 10 "systemd Journal Vacuum"
    local before; before=$(get_journal_size)
    gum log --level info "Before: $(fmt_bytes "${before}")  ·  Policy: aggressive --vacuum-size=1M"

    gum spin --spinner dot --title "journalctl --vacuum-size=1M..." -- \
        bash -c "sudo journalctl --vacuum-size=1M > /dev/null 2>&1; true"

    local after; after=$(get_journal_size)
    local freed=0; (( before > after )) && freed=$(( before - after ))
    gum log --level info "After: $(fmt_bytes "${after}")  ·  Reclaimed: $(fmt_bytes "${freed}")"
    record journal "Journal" "${before}" "${after}" SUCCESS ""
}

# ── Stage 9: Orphan Package Removal ──────────────────────────────────────────
stage_orphans() {
    section 9 10 "Orphan Package Removal"

    local orphan_list; orphan_list=$(pacman -Qdtq 2>/dev/null) || orphan_list=""

    if [[ -z "${orphan_list}" ]]; then
        gum log --level info "No orphan packages found"
        record orphans "Orphan Pkgs" 0 0 SKIPPED "None found"
        return 0
    fi

    local count; count=$(echo "${orphan_list}" | wc -l)
    gum log --level info "Found ${count} orphan package(s):"
    echo "${orphan_list}" | while read -r pkg; do printf "  • %s\n" "${pkg}"; done
    echo

    # Write packages to temp file; xargs passes them safely to pacman
    local pkg_tmp; pkg_tmp=$(mktemp /tmp/cleanup-orphans.XXXXXX)
    echo "${orphan_list}" > "${pkg_tmp}"

    if gum spin --spinner dot --title "Removing ${count} orphan(s) with pacman -Rns..." -- \
            bash -c "xargs sudo pacman -Rns --noconfirm < '${pkg_tmp}' 2>/dev/null"; then
        gum log --level info "Removed ${count} orphan package(s)"
        record orphans "Orphan Pkgs" 0 0 SUCCESS "Removed ${count} packages"
    else
        gum log --level warn "Some orphans could not be removed (may have active dependents)"
        record orphans "Orphan Pkgs" 0 0 PARTIAL "Partial removal — some packages have dependents"
    fi
    rm -f "${pkg_tmp}"
}

# ── Stage 10: Snapper Snapshot Cleanup ───────────────────────────────────────
stage_snapper() {
    section 10 10 "Snapper Snapshot Cleanup"

    if ! command -v snapper &>/dev/null; then
        gum log --level warn "Snapper not installed — skipping"
        record snapper "Snapper" 0 0 SKIPPED "Not installed"
        return 0
    fi

    local cfgs; cfgs=$(snapper list-configs 2>/dev/null | awk 'NR>2 {print $1}') || cfgs=""
    if [[ -z "${cfgs}" ]]; then
        gum log --level warn "No Snapper configurations found — skipping"
        record snapper "Snapper" 0 0 SKIPPED "No config"
        return 0
    fi

    # Prefer 'root' config, fall back to first available
    local cfg="root"
    if ! echo "${cfgs}" | grep -q "^root$"; then
        cfg=$(echo "${cfgs}" | head -n 1)
    fi
    gum log --level info "Config: ${cfg}"

    local raw_list
    if ! raw_list=$(sudo snapper -c "${cfg}" list 2>/dev/null); then
        gum log --level error "Failed to query snapper list for '${cfg}'"
        record snapper "Snapper" 0 0 FAILED "snapper list error"
        return 0
    fi

    echo
    gum style --foreground "#89b4fa" --bold "Snapshots — ${cfg}:"
    echo

    local removable_ids=()
    while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        local id; id=$(awk '{print $1}' <<< "${line}" | tr -d '+#')
        if [[ "${id}" == "0" ]]; then
            printf "  %s  \033[1;32m[PROTECTED — current system]\033[0m\n" "${line}"
        elif [[ "${id}" =~ ^[0-9]+$ ]]; then
            printf "  %s\n" "${line}"
            removable_ids+=("${id}")
        fi
    done <<< "$(echo "${raw_list}" | awk 'NR>2')"

    echo
    if (( ${#removable_ids[@]} == 0 )); then
        gum log --level info "No removable snapshots (only snapshot 0 is present)"
        record snapper "Snapper" 0 0 SKIPPED "No removable snapshots"
        return 0
    fi

    gum log --level info "Removable snapshot IDs: ${removable_ids[*]}"
    gum log --level warn "Snapshot 0 (current system) is NEVER deleted"

    # Always confirm — irreversible at Btrfs level
    echo
    gum style \
        --border normal \
        --border-foreground "#f38ba8" \
        --padding "1 2" \
        "$(gum style --foreground '#f38ba8' --bold '⚠  Irreversible Btrfs Snapshot Deletion')" \
        "" \
        "  Will delete ${#removable_ids[@]} snapshot(s): ${removable_ids[*]}" \
        "  Snapshot 0 (current system) is always protected." \
        "  limine-snapper-sync will run after deletion to sync boot entries."
    echo

    if ! gum confirm "Delete all ${#removable_ids[@]} removable snapshot(s)?"; then
        gum log --level info "Snapshot deletion cancelled"
        record snapper "Snapper" 0 0 SKIPPED "Declined"
        return 0
    fi

    local del_ok=0 del_fail=0
    for sid in "${removable_ids[@]}"; do
        if gum spin --spinner dot --title "Deleting snapshot #${sid}..." -- \
                bash -c "sudo snapper -c '${cfg}' delete '${sid}' 2>/dev/null"; then
            gum log --level info "Deleted snapshot #${sid}"
            del_ok=$(( del_ok + 1 ))
        else
            gum log --level error "Failed to delete snapshot #${sid}"
            del_fail=$(( del_fail + 1 ))
        fi
    done

    # Sync bootloader snapshot entries
    if command -v limine-snapper-sync &>/dev/null; then
        gum spin --spinner dot --title "Running limine-snapper-sync..." -- \
            bash -c "sudo limine-snapper-sync 2>/dev/null; true"
        gum log --level info "limine-snapper-sync completed"
    fi

    if (( del_fail > 0 )); then
        record snapper "Snapper" 0 0 PARTIAL "Deleted ${del_ok}, failed ${del_fail}"
    else
        record snapper "Snapper" 0 0 SUCCESS "Deleted ${del_ok} snapshot(s)"
    fi
}

# ── Phase 3: Summary ──────────────────────────────────────────────────────────
phase_summary() {
    echo
    gum style \
        --border rounded \
        --border-foreground "#a6e3a1" \
        --padding "0 3" \
        --bold \
        "  Cleanup Complete"
    echo

    local total_b=0 total_a=0 total_freed=0
    local cnt_ok=0 cnt_partial=0 cnt_skipped=0 cnt_failed=0
    local table_data="Module,Before,After,Reclaimed,Status"$'\n'

    for k in "${SK[@]}"; do
        local b="${SB[${k}]:-0}" a="${SA[${k}]:-0}" r="${SF[${k}]:-0}" st="${SS[${k}]:-}"
        total_b=$(( total_b + b ))
        total_a=$(( total_a + a ))
        total_freed=$(( total_freed + r ))

        local icon
        case "${st}" in
            SUCCESS) icon="✓"; cnt_ok=$(( cnt_ok + 1 ))           ;;
            PARTIAL) icon="~"; cnt_partial=$(( cnt_partial + 1 )) ;;
            SKIPPED) icon="—"; cnt_skipped=$(( cnt_skipped + 1 )) ;;
            FAILED)  icon="✗"; cnt_failed=$(( cnt_failed + 1 ))   ;;
            *)       icon="?"                                     ;;
        esac

        table_data+="$(printf "%s,%s,%s,%s,%s %s\n" \
            "${SL[${k}]}" \
            "$(fmt_bytes "${b}")" \
            "$(fmt_bytes "${a}")" \
            "$(fmt_bytes "${r}")" \
            "${icon}" "${st}")"$'\n'
    done
    table_data+="$(printf "TOTAL,$(fmt_bytes "${total_b}"),$(fmt_bytes "${total_a}"),$(fmt_bytes "${total_freed}"),\n")"

    printf "%s" "${table_data}" | gum table --print --widths "14,12,12,12,14"

    echo
    gum style \
        --foreground "#a6e3a1" \
        --bold \
        "  Total reclaimed: $(fmt_bytes "${total_freed}")"
    printf "  ✓ %d success  ·  ~ %d partial  ·  — %d skipped  ·  ✗ %d failed\n" \
        "${cnt_ok}" "${cnt_partial}" "${cnt_skipped}" "${cnt_failed}"

    # Print notes for partial/failed stages
    local has_notes=0
    for k in "${SK[@]}"; do
        local st="${SS[${k}]:-}" note="${SN[${k}]:-}"
        if [[ ("${st}" == "PARTIAL" || "${st}" == "FAILED") && -n "${note}" ]]; then
            if (( has_notes == 0 )); then
                echo
                gum style --foreground "#f9e2af" --bold "Notices:"
                has_notes=1
            fi
            printf "  [%s]  %s\n" "${SL[${k}]}" "${note}"
        fi
    done

    echo
    # Flush any escape sequences in the OS tty buffer (e.g. gum terminal queries ^[[?2026;2$y)
    python3 -c 'import termios, sys; termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)' 2>/dev/null || true
    while read -t 0.05 -n 1000 -r -s _ 2>/dev/null; do :; done

    read -n 1 -s -r -p "  Press any key to close..."
    echo
}

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [OPTIONS]

Arch Linux system maintenance — gum-powered TUI
Reference: ~/dotfiles/TUI_reference.md

Options:
  -h, --help       Show this help
  -v, --version    Show version (${SCRIPT_VERSION})
  -d, --dry-run    Inspect cleanup targets only — no changes made
EOF
}

# ── Entry Point ───────────────────────────────────────────────────────────────
main() {
    for arg in "$@"; do
        case "${arg}" in
            -h|--help)    usage; exit 0 ;;
            -v|--version) echo "${SCRIPT_NAME} v${SCRIPT_VERSION}"; exit 0 ;;
            -d|--dry-run) DRY=1 ;;
        esac
    done

    # 1. First display System details & Dry-run inspection (unprivileged scan)
    phase_inspect

    if (( DRY )); then
        echo
        gum log --level info "Dry-run inspection complete — no changes were made."
        exit 0
    fi

    # 2. Prompt for Sudo Password AFTER the System Information & Dry Run block
    echo
    gum style \
        --border normal \
        --border-foreground "#89b4fa" \
        --padding "0 2" \
        "$(gum style --bold --foreground '#89b4fa' 'Elevated Privileges Required')" \
        "Authenticating with sudo for system cleanup tasks..."
    echo

    init_sudo

    # 3. Affirmation & Navigation Gate (clear highlighted buttons)
    echo
    gum style \
        --border rounded \
        --border-foreground "#a6e3a1" \
        --padding "1 2" \
        "$(gum style --bold --foreground '#cdd6f4' 'Ready to proceed with system cleanup?')" \
        "" \
        "  • Safe Stages   : Coredumps, User cache, /tmp, /var/tmp, Log archives, Journal, Orphans" \
        "  • Prompt Stages : Pacman cache (-Scc), Trash, Snapper snapshots" \
        "" \
        "$(gum style --foreground '#585b70' 'Navigation: Use [Left/Right] arrows or [y/n] keys, then press [Enter] to submit.')"
    echo

    if ! gum confirm \
        --affirmative "Proceed (Enter)" \
        --negative "Skip & Exit (n/Esc)" \
        "Confirm cleanup execution:"; then
        echo
        gum log --level info "Cleanup cancelled by user."
        exit 0
    fi

    # ── Execute all stages ────────────────────────────────────────────────────
    stage_coredumps
    stage_pacman
    stage_user_cache
    stage_trash
    stage_tmp
    stage_var_tmp
    stage_trad_logs
    stage_journal
    stage_orphans
    stage_snapper

    phase_summary
}

main "$@"
